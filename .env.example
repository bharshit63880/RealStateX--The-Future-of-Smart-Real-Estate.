NODE_ENV=development
PORT=5000
API_VERSION=v1
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5000
MONGODB_URI=mongodb://127.0.0.1:27017/realstatex
MONGODB_DATABASE=realstatex
# Optional Atlas fallback when the local DNS resolver cannot resolve mongodb+srv records.
MONGODB_FALLBACK_HOSTS=
MONGODB_REPLICA_SET=
DATABASE_REQUIRED=false
COOKIE_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=30
AUTH_MAX_FAILED_LOGINS=5
AUTH_LOCK_MINUTES=15
LOG_LEVEL=info
REQUEST_BODY_LIMIT=1mb
DOCUMENT_STORAGE_PATH=storage/documents
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
VITE_APP_NAME=RealStateX
VITE_API_BASE_URL=http://localhost:5000/api/v1
